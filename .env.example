# ====================================================================
# MERA VOTE — PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Add these variables in Vercel Dashboard -> Settings -> Environment Variables
# ====================================================================

# 1. Platform & Domain Configuration
NODE_ENV=production
PRODUCTION=true
NEXT_PUBLIC_APP_URL=https://meravote.in

# 2. Cryptographic Security Secrets (Keyed HMAC & CSPRNG Token Hashing)
# Generate random 32+ character hex strings for production:
VOTING_HMAC_SECRET=c9b2f638198f4e918d3cf8372d82910fae149d682498dbf586940822184ad210
ANONYMOUS_TOKEN_SECRET=3891bca7281f94562098bdf761048f72a8190d64821a812df935029147dca812
CLIENT_SALT=civic_client_salt_entropy_2026

# 3. Admin Authentication
# Optional: Set a precomputed SHA-256 hash of your passcode for zero-plaintext storage
ADMIN_PASSCODE_HASH=
# Or plaintext passcode (will be compared in constant time):
ADMIN_PASSCODE=your_secure_admin_passcode_here
ADMIN_SESSION_SECRET=your_32_char_random_admin_session_secret

# 4. Supabase Cloud Database Credentials
# (Found in Supabase: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://nrowfnerohslghecjetf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 5. Creator Chai Support Webhooks (Optional)
KOFI_VERIFICATION_TOKEN=c7bf8b09-4bbf-4789-a823-f1ad63ff1df8
BUYMEACHAI_WEBHOOK_SECRET=your-buymeachai-secret-key

# 6. Server-Side WhatsApp OTP Dispatch (24/7 Cloud - No PC Needed)
# --------------------------------------------------------------------
# OPTION A: Free Cloud Baileys Gateway (Render / Railway / VPS / Docker)
# Deploy the standalone /whatsapp-gateway folder to Render (100% free web service)
# or Railway. Connect once via web QR portal, and your PC can be completely OFF.
WHATSAPP_BAILEYS_GATEWAY_URL=https://your-whatsapp-gateway.onrender.com
WHATSAPP_BAILEYS_API_KEY=your_optional_gateway_secret_token

# OPTION B: Meta WhatsApp Business Cloud API (100% Serverless on Vercel)
# Zero servers to maintain. Runs directly inside Vercel API routes.
# 1,000 conversations/month free from Meta:
WHATSAPP_CLOUD_API_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# OPTION C: Commercial Hosted APIs (UltraMsg / Green-API)
# WHATSAPP_ULTRAMSG_INSTANCE_ID=instance12345
# WHATSAPP_ULTRAMSG_TOKEN=your_ultramsg_token
# WHATSAPP_GREENAPI_ID_INSTANCE=1101234567
# WHATSAPP_GREENAPI_API_TOKEN=your_greenapi_token
